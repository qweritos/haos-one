[Unit]
Description=HAOS One host-assisted LAN discovery
After=network-online.target
Wants=network-online.target
Before=haos-supervisor.service hassos-supervisor.service
ConditionPathExists=/etc/haos-one/desktop-network.yaml

[Service]
Type=simple
ExecStart=/usr/local/bin/haos-one-net guest run --config /etc/haos-one/desktop-network.yaml
Restart=always
RestartSec=3s
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
