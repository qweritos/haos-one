#!/bin/sh
set -eu

docker_bin="${DOCKER_BIN:-/usr/bin/docker}"
mode_file="${UDEV_SHIM_MODE_FILE:-/etc/haos-one-compat/udev-shim-mode}"
uid_map_file="${UID_MAP_FILE:-/proc/self/uid_map}"
export DOCKER_HOST="${DOCKER_HOST:-unix:///run/docker-real.sock}"

mode="$(cat "$mode_file" 2>/dev/null || printf 'auto\n')"
case "$mode" in
  force)
    shim_required=1
    ;;
  off)
    shim_required=0
    ;;
  auto)
    shim_required=0
    if read -r inside_id outside_id _length < "$uid_map_file" 2>/dev/null; then
      if [ "$inside_id" = 0 ] && [ "$outside_id" != 0 ]; then
        shim_required=1
      fi
    fi
    ;;
  *)
    echo "haos-one: invalid udev shim mode: $mode" >&2
    exit 1
    ;;
esac

if [ "$shim_required" -ne 1 ]; then
  exit 0
fi

if ! inspect_json="$("$docker_bin" container inspect hassio_supervisor 2>&1)"; then
  case "$inspect_json" in
    *"No such container"*|*"No such object"*) exit 0 ;;
    *)
      echo "haos-one: failed to inspect hassio_supervisor: $inspect_json" >&2
      exit 1
      ;;
  esac
fi

if printf '%s\n' "$inspect_json" | jq -e '
  .[0] |
  any(.Config.Env[]?; . == "USE_UDEV_SHIM=active") and
  any(
    .Config.Env[]?;
    startswith("PYTHONPATH=") and
    ((ltrimstr("PYTHONPATH=") | split(":")) | index("/opt/haos-udev-shim") != null)
  ) and
  any(
    .Mounts[]?;
    .Destination == "/opt/haos-udev-shim" and
    .Source == "/opt/haos-one-compat/udev-shim" and
    .RW == false
  )
' >/dev/null; then
  exit 0
fi

echo "haos-one: recreating hassio_supervisor to enable the udev shim"
"$docker_bin" container rm -f hassio_supervisor >/dev/null
