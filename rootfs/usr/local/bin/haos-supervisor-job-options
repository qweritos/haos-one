#!/bin/sh

set -eu

attempt=0
max_attempts="${HAOS_JOB_OPTIONS_MAX_ATTEMPTS:-300}"
retry_interval="${HAOS_JOB_OPTIONS_RETRY_INTERVAL:-1}"

while [ "$attempt" -lt "$max_attempts" ]; do
  if /usr/bin/docker inspect hassio_cli \
    --format '{{.State.Running}}' 2>/dev/null | /bin/grep -qx true; then
    exec /usr/bin/docker exec hassio_cli \
      ha jobs options --ignore-conditions healthy --no-progress
  fi

  attempt=$((attempt + 1))
  /bin/sleep "$retry_interval"
done

echo "hassio_cli did not become ready for Supervisor job configuration" >&2
exit 1
